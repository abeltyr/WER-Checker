# =============================================================
# Required — set at least one Google key for Gemini models
# =============================================================
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Needed only for OpenAI models (gpt-4o-audio-preview, …)
OPENAI_API_KEY=

# Needed only for Hasab models (hasab-asr) — dedicated Amharic ASR.
# See https://developer.hasab.ai/
HASAB_API_KEY=
# Optional Hasab overrides (defaults shown):
# HASAB_BASE_URL=https://api.hasab.ai/api/v1
# HASAB_SOURCE_LANGUAGE=amh

# =============================================================
# Model — see `bun run cli.ts models` for the curated list + pricing
# =============================================================
MODEL_NAME=gemini-2.0-flash

# Thinking budget in tokens — 0 disables thinking
THINKING_BUDGET=0

# =============================================================
# Data source
# =============================================================
# Glob pattern pointing to parquet files, OR a directory holding the
# canonical dataset layout from `bun run normalize` (e.g. data/dataset)
DATA_PATTERN=data/*/train-*.parquet

# =============================================================
# Pipeline
# =============================================================
# Limit how many samples to process (omit = all)
MAX_SAMPLES=10

# How many AI calls in parallel
CONCURRENCY=3

# Hard deadline per AI request in seconds — hung/slow requests are
# aborted and retried instead of blocking the pipeline
REQUEST_TIMEOUT_SECONDS=120

# =============================================================
# Output
# =============================================================
OUTPUT_DIR=data/results
